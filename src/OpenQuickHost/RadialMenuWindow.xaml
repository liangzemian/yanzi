<Window x:Class="OpenQuickHost.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenQuickHost"
        Title="燕环"
        Width="1040"
        Height="1040"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter" />
    </Window.Resources>

    <Grid>
        <Ellipse Width="270"
                 Height="270"
                 Fill="#CC101010"
                 Stroke="#22FFFFFF"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding MainSeparators}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#2DFFFFFF" StrokeThickness="1"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Ellipse Width="64"
                 Height="64"
                 Fill="#F2161616"
                 Stroke="#33FFFFFF"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ActiveTitle}"
                       Foreground="#FF8E8E8E"
                       FontSize="11"
                       Width="120"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="84"
                            Height="66"
                            Background="Transparent"
                            BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="38"
                                  Height="38"
                                  HorizontalAlignment="Center"
                                  ClipToBounds="True">
                                <Image Source="{Binding IconSource}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Viewbox Width="22"
                                         Height="22"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Text="{Binding DisplayGlyph}"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF60A5FA|#FFFFFFFF'}"
                                       FontSize="11"
                                       Width="66"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Canvas Visibility="{Binding HasChildRing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse Width="240"
                     Height="240"
                     Canvas.Left="{Binding ChildRingEllipseX}"
                     Canvas.Top="{Binding ChildRingEllipseY}"
                     Fill="#BB101010"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding ChildSeparators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#2DFFFFFF" StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="64"
                     Height="64"
                     Canvas.Left="{Binding ChildRingCenterEllipseX}"
                     Canvas.Top="{Binding ChildRingCenterEllipseY}"
                     Fill="#F2161616"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <TextBlock Text="{Binding ChildRingTitle}"
                       Canvas.Left="{Binding ChildRingTitleX}"
                       Canvas.Top="{Binding ChildRingTitleY}"
                       Width="150"
                       TextAlignment="Center"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding ChildItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="76"
                                Height="60"
                                Background="Transparent"
                                BorderThickness="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="30"
                                      Height="30"
                                      HorizontalAlignment="Center"
                                      ClipToBounds="True">
                                    <Image Source="{Binding IconSource}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Viewbox Width="18"
                                             Height="18"
                                             Stretch="Uniform"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding DisplayGlyph}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF60A5FA|#FFFFFFFF'}"
                                           FontSize="10"
                                           Width="60"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <Canvas Visibility="{Binding HasGrandChildRing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse Width="220"
                     Height="220"
                     Canvas.Left="{Binding GrandChildRingEllipseX}"
                     Canvas.Top="{Binding GrandChildRingEllipseY}"
                     Fill="#B3101010"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <ItemsControl ItemsSource="{Binding GrandChildSeparators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#2DFFFFFF" StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Ellipse Width="58"
                     Height="58"
                     Canvas.Left="{Binding GrandChildRingCenterEllipseX}"
                     Canvas.Top="{Binding GrandChildRingCenterEllipseY}"
                     Fill="#F2161616"
                     Stroke="#33FFFFFF"
                     StrokeThickness="1"/>
            <TextBlock Text="{Binding GrandChildRingTitle}"
                       Canvas.Left="{Binding GrandChildRingTitleX}"
                       Canvas.Top="{Binding GrandChildRingTitleY}"
                       Width="140"
                       TextAlignment="Center"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding GrandChildItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="72"
                                Height="56"
                                Background="Transparent"
                                BorderThickness="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                            </Border.RenderTransform>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="28" Height="28" HorizontalAlignment="Center" ClipToBounds="True">
                                    <Image Source="{Binding IconSource}" Stretch="UniformToFill" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Viewbox Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF60A5FA|#FFFFFFFF'}"
                                           FontSize="10"
                                           Width="58"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Grid>
</Window>
