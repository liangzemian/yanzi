<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Yanzi</AssemblyName>
    <Product>Yanzi</Product>
    <Title>Yanzi</Title>
    <Company>Yanzi</Company>
    <Authors>Yanzi</Authors>
    <Description>Yanzi desktop launcher and extension host for Windows.</Description>
    <ApplicationIcon>yanzi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="yanzi.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="logo-white.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="logo-black.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="白透.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="黑透.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Resource>
    <Resource Include="Assets\Icons\*.svg" />
    <None Include="..\..\third_party\everything-sdk\Everything64.dll" Link="Everything64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\third_party\everything-runtime\package\**\*" LinkBase="EverythingRuntime">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\skills\**\*" LinkBase="skills">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\syncsettings.json" Link="syncsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\syncsettings.example.json" Link="syncsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Basic.Reference.Assemblies.Net90" Version="1.8.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yanzi.ExtensionHost\Yanzi.ExtensionHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="PublishExtensionHostForBuild" AfterTargets="Build">
    <Exec Command='dotnet publish "$(MSBuildThisFileDirectory)..\Yanzi.ExtensionHost\Yanzi.ExtensionHost.csproj" -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:SatelliteResourceLanguages=zh-Hans -p:DebugType=None -o "$(TargetDir)ExtensionHost"' />
  </Target>

  <Target Name="PublishExtensionHostForPublish" AfterTargets="Publish">
    <Exec Command='dotnet publish "$(MSBuildThisFileDirectory)..\Yanzi.ExtensionHost\Yanzi.ExtensionHost.csproj" -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:SatelliteResourceLanguages=zh-Hans -p:DebugType=None -o "$(PublishDir)ExtensionHost"' />
  </Target>

  <Target Name="CopyNativeWindowReferenceAssembliesForBuild" AfterTargets="Build">
    <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)..\..\scripts\copy-native-window-refs.ps1" -OutputDir "$(TargetDir)NativeWindowRefs"' />
  </Target>

  <Target Name="CopyNativeWindowReferenceAssembliesForPublish" AfterTargets="Publish">
    <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)..\..\scripts\copy-native-window-refs.ps1" -OutputDir "$(PublishDir)NativeWindowRefs"' />
  </Target>

</Project>
