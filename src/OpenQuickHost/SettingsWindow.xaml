                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Width="28" Height="28" CornerRadius="7" Background="{Binding AccentBrush}" Margin="0,0,8,0">
                                                                            <Grid>
                                                                                <Image Source="{Binding IconSource}" Width="22" Height="22" Stretch="Uniform" Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                <Viewbox Width="18" Height="18" Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                                                </Viewbox>
                                                                                <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Detail}" Foreground="#FF8E8E8E" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

