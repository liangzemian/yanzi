                                                      Click="SaveQuickPanelTrigger_Click"/>
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding EnableRadialMenu, Mode=TwoWay}" Click="SaveQuickPanelTrigger_Click"/>
                                    </Grid>

                                    <TextBlock Text="鼠标触发"
                                               Foreground="#FFB8B8B8"
                                               FontSize="12"
                                               Margin="0,12,0,0"/>
                                    <Border Margin="0,6,0,0"
                                            Background="#FF101014"
                                            BorderBrush="#FF2A2A2A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,9">
                                        <TextBlock Text="{Binding RadialAssignedMouseTriggerSummary}"
