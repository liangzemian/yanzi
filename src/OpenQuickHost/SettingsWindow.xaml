                                                                                             Height="{Binding VectorIconSize}"
                                                                                             Stretch="Uniform"
                                                                                             HorizontalAlignment="Center"
                                                                                             VerticalAlignment="Center"
                                                                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                                                    </Viewbox>
                                                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                                                               Foreground="White"
                                                                                               FontSize="{Binding GlyphFontSize}"
                                                                                               FontWeight="SemiBold"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       Foreground="#FF60A5FA"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center"
                                                                                       FontSize="10"
                                                                                       >
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasPresentationIcon}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding ExtensionTitle}"
                                                                                       Foreground="#FFE5E5E5"
                                                                                       FontSize="10"
                                                                                       Margin="0,5,0,0"
                                                                                       TextAlignment="Center"
                                                                                       Width="{Binding TitleWidth}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="把右侧扩展拖到这里"/>
                                                                            <TextBlock Text="{Binding ChildPageTitle}"
                                                                                       Foreground="#FF8E8E8E"
                                                                                       FontSize="10"
                                                                                       Margin="0,3,0,0"
                                                                                       TextAlignment="Center"
                                                                                       Width="{Binding TitleWidth}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Visibility="{Binding HasChildPageTitle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                       ToolTip="子环入口"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Border>

                                        <Border Grid.Column="1" Background="#FF161616" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="搜索添加到方向槽位" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RadialMenuSelectedSlotSummary}" Foreground="#FF8E8E8E" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                                    <TextBox x:Name="RadialMenuSearchBox"
                                                             Text="{Binding RadialMenuSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30"
                                                             Margin="0,0,0,8"
                                                             ToolTip="搜索扩展、应用、系统设置项。按 ↓ 选择，Enter 添加到当前槽位。"
                                                             PreviewKeyDown="RadialMenuSearchBox_PreviewKeyDown"/>
                                                </StackPanel>
                                                <ScrollViewer Grid.Row="1" MaxHeight="310" VerticalScrollBarVisibility="Auto">
                                                    <ListBox ItemsSource="{Binding FilteredRadialMenuCommandOptions}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="White"
                                                             PreviewKeyDown="RadialMenuCommandListBox_PreviewKeyDown"
                                                             MouseDoubleClick="RadialMenuCommandListBox_MouseDoubleClick">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#FF202020"
                                                                        BorderBrush="#1AFFFFFF"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="8"
