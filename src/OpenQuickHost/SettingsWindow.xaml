                                                                        <MenuItem Header="删除扩展/应用/系统项" Click="RadialSlotClearCommandMenuItem_Click"/>
                                                                        <Separator/>
                                                                        <MenuItem Header="添加子环" Click="RadialSlotAddChildPageMenuItem_Click"/>
                                                                        <MenuItem Header="删除子环" Click="RadialSlotClearChildPageMenuItem_Click"/>
