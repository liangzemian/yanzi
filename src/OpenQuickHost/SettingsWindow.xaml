                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="➕"
                                                                                   Foreground="#90FFFFFF"
                                                                                   FontSize="{Binding PlusFontSize}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
