<Window x:Class="OpenQuickHost.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenQuickHost"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Settings"
        Width="1024"
        Height="768"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#FF1A1A1A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />

        <!-- Colors -->
        <Color x:Key="SidebarBG">#FF1E1E1E</Color>
        <Color x:Key="ContentBG">#FF161616</Color>
        <Color x:Key="BorderColor">#FF2A2A2A</Color>
        <Color x:Key="AccentColor">#FF3B82F6</Color>
        <Color x:Key="TextMain">#FFFFFFFF</Color>
        <Color x:Key="TextSecondary">#FF8E8E8E</Color>
        
        <Style x:Key="SidebarListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="12,8"
                                CornerRadius="8"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF2D2D2D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF252525" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch Style (Raycast style) -->
        <Style x:Key="RaycastSwitchStyle" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track"
                                    CornerRadius="10"
                                    Background="#FF333333" />
                            <Ellipse x:Name="Thumb"
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="White">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF3B82F6" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                           To="16" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" 
                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                           To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF666666" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF252525" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateStoreBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#FF16A34A" />
        </Style>

        <Style x:Key="GestureAssignBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF8E8E8E" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF2D2D2D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status Badge Styles -->
        <Style x:Key="PublishedBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A16A34A" />
            <Setter Property="BorderBrush" Value="#FF16A34A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="DisabledBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A666666" />
            <Setter Property="BorderBrush" Value="#FF666666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <!-- Filter Tab Style -->
        <Style x:Key="FilterTabStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="FilterTabActiveStyle" TargetType="Border" BasedOn="{StaticResource FilterTabStyle}">
            <Setter Property="Background" Value="#FF2D2D2D" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Margin="1"
            CornerRadius="12"
            Background="#F2161616"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            PreviewMouseLeftButtonDown="WindowFrame_PreviewMouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (Left) -->
            <Border Grid.Column="0" 
                    Background="#FF1E1E1E" 
                    CornerRadius="12,0,0,12"
                    BorderBrush="#FF2A2A2A"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="22,18,22,12"
                               Text="设置"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF888888" />

                    <!-- Account Section -->
                    <Button Grid.Row="1"
                            Margin="10,0,10,10"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AccountButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="16"
                                                Background="#1A3B82F6"
                                                VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18">
                                                <Path Data="{local:IconGeometry user}" Fill="#FF3B82F6" Stretch="Uniform"/>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountTitle}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="White" />
                                            <TextBlock Text="账户"
                                                       Foreground="#FF666666"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#FF252525" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AccountMenu">
                                <MenuItem Header="登录或切换账号" Click="SignInMenuItem_Click" />
                                <MenuItem Header="退出登录" Click="SignOutMenuItem_Click" />
                                <Separator />
                                <MenuItem Header="刷新云状态" Click="RefreshAccountMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Global Search Box -->
                    <Border Grid.Row="2"
                            Margin="10,0,10,15" 
                            Background="#FF181818" 
                            CornerRadius="6" 
                            BorderBrush="#FF2A2A2A" 
                            BorderThickness="1"
                            Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{local:IconGeometry search}" Fill="#FF666666" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBox Grid.Column="1" 
                                     x:Name="SettingsSearchBox"
                                     Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="White" 
                                     CaretBrush="White"
                                     VerticalAlignment="Center"
                                     FontSize="13"/>
                            <TextBlock Grid.Column="1" 
                                       Text="搜索设置项..." 
                                       Foreground="#FF555555" 
                                       VerticalAlignment="Center" 
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SettingsSearchText}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SettingsSearchBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                             Style="{StaticResource SidebarListBoxStyle}"
                             ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20"
                                            Height="20"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0">
                                        <Path x:Name="IconPath"
                                              Data="{Binding IconGeometry}"
                                              Fill="{Binding Accent}"
                                              Opacity="0.8"
                                              Stretch="Uniform" 
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               Foreground="White"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Content Area (Right) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Top Bar -->
                    <RowDefinition Height="*" />    <!-- Main Content -->
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Grid Grid.Row="0" Margin="15,10,15,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NavButtonStyle}" Margin="0,0,5,0">
                            <Viewbox Width="12" Height="12">
                                <Path Data="{local:IconGeometry arrow-left}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <Viewbox Width="12" Height="12">
                                <Path Data="{local:IconGeometry arrow-left}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource NavButtonStyle}" Click="CloseButton_Click" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12">
                                <Path Data="{local:IconGeometry minimize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Click="CloseButton_Click" Margin="5,0,0,0">
                            <Viewbox Width="12" Height="12">
                                <Path Data="{local:IconGeometry close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,10,30,30">
                        
                        <!-- General Settings View -->
                        <StackPanel Visibility="{Binding IsGeneralSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="常规" Foreground="#FF888888" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            
                            <Grid Margin="0,5">
                                <TextBlock Text="开机启动" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#FF222222" Margin="0,12"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="关闭时最小化到系统托盘" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#FF222222" Margin="0,12"/>

                            <Grid Margin="0,5">
                                <TextBlock Text="启动后自动刷新云状态" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding RefreshCloudOnStartup, Mode=TwoWay}" Click="SaveSettingsToggle_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#FF222222" Margin="0,12"/>

                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="16" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="主程序快捷键" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="用于呼出或隐藏启动器。" Foreground="#FF8E8E8E" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#FF2D2D2D" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LauncherHotkey}" Foreground="White" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="修改快捷键" Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0" Margin="0,0,8,0" Click="EditLauncherHotkeyButton_Click"/>
                                        <Button Content="重置为 Alt+Space" Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0" Click="ResetLauncherHotkeyButton_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="主程序快捷键修改后会立即重新注册。支持常规组合键，也支持录制 DoubleCtrl / DoubleAlt。" Foreground="#FF8E8E8E" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="14" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="说明" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="基础行为设置会在保存后立即生效。" Foreground="#FF8E8E8E" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAiSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="AI" Foreground="#FF888888" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="AI 对话配置" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="用于 AI 对话和后续 AI 扩展调用，支持本地或远程 OpenAI 兼容接口。" Foreground="#FF8E8E8E" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="服务地址" Foreground="#FFB8B8B8" FontSize="12" Margin="0,16,0,0" />
                                    <TextBox x:Name="AiBaseUrlTextBox" Text="{Binding AiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" TextChanged="AiSettings_TextChanged"/>

                                    <TextBlock Text="API Key" Foreground="#FFB8B8B8" FontSize="12" Margin="0,14,0,0" />
                                    <TextBox x:Name="AiApiKeyTextBox" Text="{Binding AiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" TextChanged="AiSettings_TextChanged"/>

                                    <TextBlock Text="模型名" Foreground="#FFB8B8B8" FontSize="12" Margin="0,14,0,0" />
                                    <TextBox x:Name="AiModelTextBox" Text="{Binding AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" TextChanged="AiSettings_TextChanged"/>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AiSettingsStatusText}" Foreground="#FF8E8E8E" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Name="SaveAiButton" Grid.Column="1" Content="保存" Style="{StaticResource PrimaryBtn}" Click="SaveAiSettingsButton_Click" IsEnabled="{Binding HasAiSettingsChanged}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sync View -->
                        <StackPanel Visibility="{Binding IsSyncSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Header with Status Badge -->
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="同步设置" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="管理您的数据备份与多设备同步配置" Foreground="#FF8E8E8E" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" 
                                        Background="#1A22C55E" 
                                        BorderBrush="#3322C55E" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#FF22C55E" VerticalAlignment="Center"/>
                                        <TextBlock Text="上次同步: 刚刚" Foreground="#FF22C55E" FontSize="11" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- WebDAV Configuration Card -->
                            <Border Background="#FF1E1E1E" CornerRadius="10" BorderBrush="#FF2A2A2A" BorderThickness="1" Margin="0,0,0,16">
                                <!-- Card Header -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header with Toggle -->
                                    <Border Grid.Row="0" Background="#0AFFFFFF" BorderBrush="#FF2A2A2A" BorderThickness="0,0,0,1" Padding="20,16">
                                        <Grid>
                                            <TextBlock Text="个人扩展同步 (WebDAV)" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="启用同步" Foreground="#FF8E8E8E" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <CheckBox Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding EnableWebDavSync, Mode=TwoWay}" Click="SaveWebDavSettingsButton_Click" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Configuration Fields -->
                                    <Grid Grid.Row="1" Margin="20,20,20,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 1: Server URL (spans 2 columns) -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                            <TextBlock Text="服务地址" Foreground="#FF8E8E8E" FontSize="11" FontWeight="Medium" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding WebDavServerUrl, Mode=TwoWay}" Height="36" Padding="12,8" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Row 2: Root Path and Username -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
