                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="在按钮上松开后执行动作" Foreground="White" FontSize="13"/>
                                        <TextBlock Text="启用后，长按或拖动触发时，移动到扩展上松开即可自动运行。" Foreground="#FF8E8E8E" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource RaycastSwitchStyle}" IsChecked="{Binding ExecuteOnButtonRelease, Mode=TwoWay}" Click="SaveQuickPanelTrigger_Click"/>
                                </Grid>
                            </Border>

                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="15" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="燕环与燕幕的鼠标触发已独立管理" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="这里统一分配每个鼠标手势的归属。燕环和燕幕页只展示当前分配结果，不能再单独修改鼠标触发。" Foreground="#FF8E8E8E" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
