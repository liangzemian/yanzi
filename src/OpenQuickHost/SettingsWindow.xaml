                                                      IsReadOnly="True"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedRadialMenuPageId, Mode=TwoWay}"
                                                      ToolTip="滚轮会在这些轮盘页面之间切换"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="新增页面" Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0" Margin="0,0,8,0" Click="AddRadialMenuPageButton_Click"/>
                                            <Button Content="删除页面" Style="{StaticResource SecondaryBtn}" Height="28" Padding="10,0" Click="DeleteRadialMenuPageButton_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="390"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="360"
                                                Height="360"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="0"
                                                CornerRadius="180">
                                            <Canvas Width="360" Height="360">
                                                <Ellipse Width="360"
                                                         Height="360"
                                                         Fill="#AA101010"
                                                         Stroke="#22FFFFFF"
                                                         StrokeThickness="1"
                                                         Canvas.Left="0"
                                                         Canvas.Top="0"/>

                                                <Ellipse Width="226"
                                                         Height="226"
                                                         Fill="#CC101010"
                                                         Stroke="#22FFFFFF"
                                                         StrokeThickness="1"
                                                         Canvas.Left="67"
                                                         Canvas.Top="67"/>

                                                <Ellipse Width="226"
                                                         Height="226"
                                                         Fill="Transparent"
                                                         Stroke="#33FFFFFF"
                                                         StrokeThickness="1.5"
                                                         Canvas.Left="67"
                                                         Canvas.Top="67"
                                                         IsHitTestVisible="False"/>

                                                <ItemsControl ItemsSource="{Binding RadialMenuPreviewSeparators}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#2DFFFFFF" StrokeThickness="1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Width="70"
                                                        Height="70"
                                                        Canvas.Left="145"
                                                        Canvas.Top="145"
