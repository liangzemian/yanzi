                                <Button Content="保存配置" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Click="SaveQuickPanelTrigger_Click"/>
                            </Grid>
                            <Rectangle Height="1" Fill="#FF222222" Margin="0,12"/>

                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="启用燕环" Foreground="White" FontSize="13"/>
