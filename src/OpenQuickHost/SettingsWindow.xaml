                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                                                                <Setter Property="Fill" Value="#16FFFFFF"/>
                                                                                <Setter Property="Stroke" Value="#40FFFFFF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding RadialMenuSlots}">
