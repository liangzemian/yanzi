                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding YarnSelectRules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#FF2A2A2A" BorderThickness="0,1,0,0" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52"/>
                                                            <ColumnDefinition Width="86"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding TriggerKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 Height="30"
                                                                 Margin="0,0,8,0"
                                                                 ToolTip="填写单个字母/数字，或 Right、X1、X2"/>
                                                        <ComboBox Grid.Column="2"
                                                                  Height="30"
                                                                  Margin="0,0,8,0"
                                                                  ItemsSource="{Binding DataContext.YarnSelectActionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding ActionType, Mode=TwoWay}"/>
                                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                            <TextBox Text="{Binding ExtensionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Height="30"
                                                                     ToolTip="搜索并选择扩展。动作类型为运行扩展时，会把选中文本作为参数传入"
                                                                     GotKeyboardFocus="YarnSelectExtensionSearchBox_GotKeyboardFocus"
                                                                     TextChanged="YarnSelectExtensionSearchBox_TextChanged"
                                                                     PreviewKeyDown="YarnSelectExtensionSearchBox_PreviewKeyDown"/>
                                                            <ListBox ItemsSource="{Binding FilteredExtensionOptions}"
                                                                     MaxHeight="126"
                                                                     Margin="0,6,0,0"
                                                                     Visibility="{Binding FilteredExtensionListVisibility}"
                                                                     Background="#FF171717"
                                                                     BorderBrush="#FF2A2A2A"
                                                                     BorderThickness="1"
                                                                     Foreground="White"
                                                                     PreviewKeyDown="YarnSelectExtensionListBox_PreviewKeyDown"
                                                                     MouseDoubleClick="YarnSelectExtensionListBox_MouseDoubleClick">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="30"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Width="24"
                                                                                    Height="24"
                                                                                    CornerRadius="6"
                                                                                    Background="{Binding AccentBrush}"
                                                                                    ClipToBounds="True"
                                                                                    VerticalAlignment="Center">
                                                                                <Grid>
                                                                                    <Image Source="{Binding IconSource}"
                                                                                           Stretch="UniformToFill"
                                                                                           Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                    <Viewbox Width="14"
                                                                                             Height="14"
                                                                                             Stretch="Uniform"
                                                                                             Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                        <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                                                    </Viewbox>
                                                                                    <TextBlock Text="{Binding DisplayGlyph}"
                                                                                               Foreground="White"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12"/>
                                                                                <TextBlock Text="{Binding Detail}" Foreground="#FF8E8E8E" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="4"
                                                                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="30"
                                                                 Margin="0,0,8,0"
                                                                 ToolTip="备注"/>
                                                        <Button Grid.Column="5"
                                                                Content="删除"
                                                                Style="{StaticResource SecondaryBtn}"
                                                                Height="28"
                                                                Padding="10,0"
                                                                Click="DeleteYarnSelectRuleButton_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="进程白名单" Foreground="#FF888888" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,10"/>
                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="留空表示所有程序都生效；填写后只对这些进程生效。多个进程用逗号或换行分隔，可填 code、excel、photoshop 或 xxx.exe。" Foreground="#FF8E8E8E" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding YarnSelectWhitelistedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,10,0,0"
                                             MinHeight="70"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <Button Content="保存白名单" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveYarnSelectSettings_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="进程黑名单" Foreground="#FF888888" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,10"/>
                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="当白名单为空时，这里的进程会被排除；多个进程用逗号或换行分隔。可填写 code、excel、photoshop 或 xxx.exe。" Foreground="#FF8E8E8E" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding YarnSelectBlacklistedProcessesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,10,0,0"
                                             MinHeight="70"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <Button Content="保存黑名单" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveYarnSelectSettings_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="使用方式：拖拽选中文字后不要松开左键，直接按 C / S / R 等按键。第一次使用建议先在普通文本框中测试。" Foreground="#FF666666" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>

                        <!-- Extensions View -->
                        <StackPanel Visibility="{Binding IsExtensionsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="扩展管理" Foreground="#FF888888" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding LocalExtensionSummary}" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding ExtensionsRootPath}" Foreground="#FF8E8E8E" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="打开目录" Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0" Click="OpenExtensionsFolderButton_Click"/>
                                        <Button Content="刷新" Style="{StaticResource SecondaryBtn}" Click="RefreshExtensionStatsButton_Click" IsEnabled="{Binding CanRefreshExtensions}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#FF1E1E1E" CornerRadius="8" BorderBrush="#FF2A2A2A" BorderThickness="1" Padding="16" Margin="0,16,0,0">
                                <StackPanel>
                                    <!-- Filter Tabs -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border x:Name="FilterAllTab" Style="{StaticResource FilterTabActiveStyle}" MouseLeftButtonDown="FilterTab_Click" Tag="all">
                                            <TextBlock Text="全部" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                        </Border>
                                        <Border x:Name="FilterPublishedTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="published">
                                            <TextBlock Text="已发布" Foreground="#FF8E8E8E" FontSize="13" FontWeight="Medium"/>
                                        </Border>
                                        <Border x:Name="FilterDisabledTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="disabled">
                                            <TextBlock Text="已禁用" Foreground="#FF8E8E8E" FontSize="13" FontWeight="Medium"/>
                                        </Border>
                                        <Border x:Name="FilterShortcutTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="shortcut">
                                            <TextBlock Text="快捷键" Foreground="#FF8E8E8E" FontSize="13" FontWeight="Medium"/>
                                        </Border>
                                        <Border x:Name="FilterRecycleTab" Style="{StaticResource FilterTabStyle}" Margin="8,0,0,0" MouseLeftButtonDown="FilterTab_Click" Tag="recycle">
                                            <TextBlock Text="回收站" Foreground="#FF8E8E8E" FontSize="13" FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ExtensionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="34"
                                                 Padding="12,8"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="按名称、ID、分类搜索扩展"
                                                 IsEnabled="{Binding CanRefreshExtensions}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ExtensionSearchSummary}"
                                                   Foreground="#FF8E8E8E"
                                                   FontSize="12"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Background="#FF181818" CornerRadius="6" BorderBrush="#FF262626" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid Margin="14,12,14,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.3*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="扩展" Foreground="#FF8E8E8E" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="分类" Foreground="#FF8E8E8E" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="版本" Foreground="#FF8E8E8E" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="3" Text="启用" Foreground="#FF8E8E8E" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="4" Text="操作" Foreground="#FF8E8E8E" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <ItemsControl Grid.Row="1"
                                                          ItemsSource="{Binding ExtensionItems}"
                                                          Visibility="{Binding ExtensionsListVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#FF252525" BorderThickness="0,1,0,0" Padding="14,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2.3*" />
                                                                    <ColumnDefinition Width="1.1*" />
                                                                    <ColumnDefinition Width="0.8*" />
                                                                    <ColumnDefinition Width="0.8*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        <!-- Published Badge -->
                                                                        <Border Style="{StaticResource PublishedBadgeStyle}" Margin="8,0,0,0" Visibility="{Binding PublishedBadgeVisibility}">
                                                                            <TextBlock Text="已发布" Foreground="#FF16A34A" FontSize="10" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                        <!-- Shortcut Badge -->
                                                                        <Border Background="#1A3B82F6" BorderBrush="#FF3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Visibility="{Binding ShortcutBadgeVisibility}">
                                                                            <TextBlock Text="{Binding ShortcutLabel}" Foreground="#FF3B82F6" FontSize="10" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding ExtensionId}" Foreground="#FF8E8E8E" FontSize="11" Margin="0,4,0,0"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#FFE5E5E5" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Version}" Foreground="#FFE5E5E5" FontSize="12" VerticalAlignment="Center"/>
                                                                <CheckBox Grid.Column="3"
                                                                          Style="{StaticResource RaycastSwitchStyle}"
                                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                          VerticalAlignment="Center"
                                                                          Click="ExtensionEnabledSwitch_Click"/>

                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <!-- Shortcut Icon Button -->
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,4,0" 
                                                                            Click="EditExtensionShortcutButton_Click"
                                                                            ToolTip="设置快捷键">
                                                                        <Viewbox Width="14" Height="14">
                                                                            <Path Data="{local:IconGeometry shortcut}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                    <!-- Edit Icon Button -->
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,4,0" 
                                                                            IsEnabled="{Binding EditButtonEnabled}" 
                                                                            Click="EditExtensionButton_Click"
                                                                            ToolTip="编辑">
                                                                        <Viewbox Width="14" Height="14">
                                                                            <Path Data="{local:IconGeometry edit}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                    <!-- Open Directory Icon Button -->
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,4,0" 
                                                                            IsEnabled="{Binding OpenDirectoryButtonEnabled}" 
                                                                            Click="OpenExtensionDirectoryButton_Click"
                                                                            ToolTip="打开目录">
                                                                        <Viewbox Width="14" Height="14">
                                                                            <Path Data="{local:IconGeometry folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                    <!-- Delete Icon Button (Recycle) -->
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,8,0" 
                                                                            IsEnabled="{Binding DeleteButtonEnabled}" 
                                                                            Click="DeleteExtensionButton_Click"
                                                                            ToolTip="移入回收站">
                                                                        <Viewbox Width="14" Height="14">
                                                                            <Path Data="{local:IconGeometry recycle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                    <!-- Publish/Unpublish Icon Buttons -->
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,4,0" 
                                                                            IsEnabled="{Binding PublishButtonEnabled}" 
                                                                            Visibility="{Binding PublishNewButtonVisibility}" 
                                                                            Click="PublishExtensionButton_Click"
                                                                            ToolTip="发布到商店">
                                                                        <Grid Width="14" Height="14">
                                                                            <Grid Visibility="{Binding PublishSpinnerVisibility}">
                                                                                <Ellipse Stroke="#FF4B5563" StrokeThickness="2"/>
                                                                                <Path Data="M 7,1 A 6,6 0 1 1 6.99,1"
                                                                                      Stroke="#FFFFFFFF"
                                                                                      StrokeThickness="2"
                                                                                      StrokeStartLineCap="Round"
                                                                                      StrokeEndLineCap="Round">
                                                                                    <Path.RenderTransform>
                                                                                        <RotateTransform CenterX="7" CenterY="7"/>
                                                                                    </Path.RenderTransform>
                                                                                    <Path.Triggers>
                                                                                        <EventTrigger RoutedEvent="Loaded">
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                                     From="0"
                                                                                                                     To="360"
                                                                                                                     Duration="0:0:0.8"/>
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </EventTrigger>
                                                                                    </Path.Triggers>
                                                                                </Path>
                                                                            </Grid>
                                                                            <Viewbox Visibility="{Binding PublishIconVisibility}">
                                                                                <Path Data="{local:IconGeometry store}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                            </Viewbox>
                                                                        </Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,4,0" 
                                                                            IsEnabled="{Binding PublishButtonEnabled}" 
                                                                            Visibility="{Binding PublishUpdateButtonVisibility}" 
                                                                            Click="PublishExtensionButton_Click"
                                                                            ToolTip="更新商店版本">
                                                                        <Grid Width="14" Height="14">
                                                                            <Grid Visibility="{Binding PublishSpinnerVisibility}">
                                                                                <Ellipse Stroke="#FF16A34A" StrokeThickness="2"/>
                                                                                <Path Data="M 7,1 A 6,6 0 1 1 6.99,1"
                                                                                      Stroke="#FFFFFFFF"
                                                                                      StrokeThickness="2"
                                                                                      StrokeStartLineCap="Round"
                                                                                      StrokeEndLineCap="Round">
                                                                                    <Path.RenderTransform>
                                                                                        <RotateTransform CenterX="7" CenterY="7"/>
                                                                                    </Path.RenderTransform>
                                                                                    <Path.Triggers>
                                                                                        <EventTrigger RoutedEvent="Loaded">
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                                     From="0"
                                                                                                                     To="360"
                                                                                                                     Duration="0:0:0.8"/>
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </EventTrigger>
                                                                                    </Path.Triggers>
                                                                                </Path>
                                                                            </Grid>
                                                                            <Viewbox Visibility="{Binding PublishIconVisibility}">
                                                                                <Path Data="{local:IconGeometry store}" Fill="#FF16A34A" Stretch="Uniform"/>
                                                                            </Viewbox>
                                                                        </Grid>
                                                                    </Button>
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,4,0" 
                                                                            IsEnabled="{Binding UnpublishButtonEnabled}" 
                                                                            Visibility="{Binding UnpublishButtonVisibility}" 
                                                                            Click="UnpublishExtensionButton_Click"
                                                                            ToolTip="下线">
                                                                        <Grid Width="14" Height="14">
                                                                            <Grid Visibility="{Binding UnpublishSpinnerVisibility}">
                                                                                <Ellipse Stroke="#FF4B5563" StrokeThickness="2"/>
                                                                                <Path Data="M 7,1 A 6,6 0 1 1 6.99,1"
                                                                                      Stroke="#FFFFFFFF"
                                                                                      StrokeThickness="2"
                                                                                      StrokeStartLineCap="Round"
                                                                                      StrokeEndLineCap="Round">
                                                                                    <Path.RenderTransform>
                                                                                        <RotateTransform CenterX="7" CenterY="7"/>
                                                                                    </Path.RenderTransform>
                                                                                    <Path.Triggers>
                                                                                        <EventTrigger RoutedEvent="Loaded">
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                                     From="0"
                                                                                                                     To="360"
                                                                                                                     Duration="0:0:0.8"/>
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </EventTrigger>
                                                                                    </Path.Triggers>
                                                                                </Path>
                                                                            </Grid>
                                                                            <Viewbox Visibility="{Binding UnpublishIconVisibility}">
                                                                                <Path Data="{local:IconGeometry store}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                            </Viewbox>
                                                                        </Grid>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Recycle Bin Items List -->
                                            <ItemsControl Grid.Row="1"
                                                          ItemsSource="{Binding RecycleBinItems}"
                                                          Visibility="{Binding RecycleBinListVisibility}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#FF252525" BorderThickness="0,1,0,0" Padding="14,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2.3*" />
                                                                    <ColumnDefinition Width="1.1*" />
                                                                    <ColumnDefinition Width="0.8*" />
                                                                    <ColumnDefinition Width="0.8*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding ExtensionId}" Foreground="#FF8E8E8E" FontSize="11" Margin="0,4,0,0"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#FFE5E5E5" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Version}" Foreground="#FFE5E5E5" FontSize="12" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding DeletedAtLabel}" Foreground="#FF8E8E8E" FontSize="11" VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <!-- Restore Button -->
                                                                    <Button Style="{StaticResource SecondaryBtn}" 
                                                                            Height="28" 
                                                                            Padding="10,0" 
                                                                            Margin="0,0,8,0" 
                                                                            Content="恢复" 
                                                                            Click="RestoreRecycleBinExtensionButton_Click"
                                                                            ToolTip="恢复扩展"/>
                                                                    <!-- Permanent Delete Button -->
                                                                    <Button Style="{StaticResource IconButtonStyle}" 
                                                                            Margin="0,0,4,0" 
                                                                            Click="DeleteRecycleBinExtensionButton_Click"
                                                                            ToolTip="永久删除">
                                                                        <Viewbox Width="14" Height="14">
                                                                            <Path Data="{local:IconGeometry trash}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                                                        </Viewbox>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Grid Grid.Row="1" Visibility="{Binding ExtensionsLoadingVisibility}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="36" Height="36">
                                                        <Ellipse Stroke="#FF2F2F2F" StrokeThickness="3"/>
                                                        <Path Data="M 18,3 A 15,15 0 1 1 17.99,3"
                                                              Stroke="#FFF97316"
                                                              StrokeThickness="3"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round">
                                                            <Path.RenderTransform>
                                                                <RotateTransform CenterX="18" CenterY="18"/>
                                                            </Path.RenderTransform>
                                                            <Path.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0"
                                                                                             To="360"
                                                                                             Duration="0:0:0.8"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Path.Triggers>
                                                        </Path>
                                                    </Grid>
                                                    <TextBlock Text="正在后台刷新扩展数据..."
                                                               Foreground="#FFE5E5E5"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,12,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>


                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Thumb Grid.ColumnSpan="2"
                   Height="6"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Cursor="SizeNS"
                   DragDelta="ResizeTopThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Height="6"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNS"
                   DragDelta="ResizeBottomThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="6"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="ResizeLeftThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="6"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="ResizeRightThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="4,4,0,0"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeTopLeftThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,4,4,0"
                   Cursor="SizeNESW"
                   DragDelta="ResizeTopRightThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="4,0,0,4"
                   Cursor="SizeNESW"
                   DragDelta="ResizeBottomLeftThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Thumb Grid.ColumnSpan="2"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,8,8"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeBottomRightThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 4,14 L 14,4 M 8,14 L 14,8 M 12,14 L 14,12"
                                  Stroke="#FF6B7280"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            
            <!-- Toast Notification -->
            <Border x:Name="ToastNotification"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,60,20,0"
                    Background="#FF22C55E"
                    CornerRadius="8"
                    Padding="16,12"
                    Visibility="Collapsed"
                    Panel.ZIndex="1000">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="12" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform" X="400"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                        <Path Data="{local:IconGeometry check}" Fill="White" Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock x:Name="ToastMessage" 
                               Text="已保存" 
                               Foreground="White" 
                               FontSize="13" 
                               FontWeight="Medium"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
