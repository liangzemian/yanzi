                                                        MouseLeftButtonDown="RadialMenuCenter_MouseLeftButtonDown"
                                                        MouseRightButtonDown="RadialMenuCenter_MouseRightButtonDown">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="重命名当前轮盘" Click="RenameRadialMenuPageMenuItem_Click"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Ellipse Fill="#F2161616"
                                                                 Stroke="#33FFFFFF"
                                                                 StrokeThickness="1"
                                                                 IsHitTestVisible="False"/>
                                                        <TextBlock Text="{Binding SelectedRadialMenuPageName}"
