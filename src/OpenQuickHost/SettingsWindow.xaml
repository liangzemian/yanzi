                                <StackPanel>
                                    <TextBlock Text="游戏轮盘模式" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="{Binding RadialMenuSummary}" Foreground="#FF666666" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
