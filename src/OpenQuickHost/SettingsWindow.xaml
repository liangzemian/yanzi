                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Section 4: 面板交互选项 -->
                            <TextBlock Text="面板交互选项" Foreground="#FFB8B8B8" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,10"/>
