                                                                   Foreground="White"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="6,0"
                                                                   IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding RadialMenuSlots}">
