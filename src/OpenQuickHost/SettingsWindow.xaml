                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="当前轮盘" Foreground="#FFB8B8B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
