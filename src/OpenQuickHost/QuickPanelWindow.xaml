<Window x:Class="OpenQuickHost.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenQuickHost"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="鼠标面板" Height="620" Width="340"
        WindowStyle="None"
        Background="#FF1A1A1A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="4"
                            CornerRadius="16"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="1"
            Background="#F21A1A1A"
            CornerRadius="20"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar -->
            <Border Grid.RowSpan="4" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" Padding="0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource SidebarButtonStyle}" Width="32" Height="32" ToolTip="通用收藏" Click="ToggleGlobalFavorites_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#FFFBBF24">
                                        <Path.Data>M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <ItemsControl ItemsSource="{Binding GlobalGroups}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GroupButtonStyle}"
                                            Margin="0,0,0,6"
                                            Tag="{Binding}"
                                            Click="GlobalGroupButton_Click"
                                            ToolTip="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="重命名分组" Click="RenameGlobalGroup_Click" CommandParameter="{Binding}" />
                                                <MenuItem Header="删除分组" Click="DeleteGlobalGroup_Click" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Background>
                                            <Binding Path="IsSelected" Converter="{StaticResource BooleanToColorConverter}" ConverterParameter="Transparent|#1A3B82F6"/>
                                        </Button.Background>
                                        <TextBlock Text="{Binding ShortName}"
                                                   Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF6EA8FF|#FFFFFFFF'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource SidebarButtonStyle}" Width="32" Height="32" ToolTip="新建通用分组" Click="AddGlobalGroupButton_Click">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{local:IconGeometry plus}" Fill="#FFFFFFFF" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        </StackPanel>
                    </Border>

                    <Rectangle Grid.Row="2" Height="1" Fill="#18FFFFFF" Margin="6,0"/>

                    <Border Grid.Row="3">
                        <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Style="{StaticResource SidebarButtonStyle}" Width="32" Height="32" ToolTip="专属收藏" Click="ToggleContextFavorites_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#FFFBBF24">
                                        <Path.Data>M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Path.Data>
                                    </Path>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <ItemsControl ItemsSource="{Binding ContextGroups}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GroupButtonStyle}"
                                            Margin="0,0,0,6"
                                            Tag="{Binding}"
                                            Click="ContextGroupButton_Click"
                                            ToolTip="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="重命名分组" Click="RenameContextGroup_Click" CommandParameter="{Binding}" />
                                                <MenuItem Header="删除分组" Click="DeleteContextGroup_Click" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Background>
                                            <Binding Path="IsSelected" Converter="{StaticResource BooleanToColorConverter}" ConverterParameter="Transparent|#1A22C55E"/>
                                        </Button.Background>
                                        <TextBlock Text="{Binding ShortName}"
                                                   Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF4ADE80|#FFFFFFFF'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource SidebarButtonStyle}" Width="32" Height="32" ToolTip="新建专属分组" Click="AddContextGroupButton_Click">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{local:IconGeometry plus}" Fill="#FFFFFFFF" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                        </StackPanel>
                    </Border>
                    
                    <Button Grid.Row="4" Style="{StaticResource SidebarButtonStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="SettingsButton_Click" Width="32" Height="32" ToolTip="设置">
                        <Viewbox Width="16" Height="16">
                            <Path Data="{local:IconGeometry settings}" Fill="#FF888888" Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Top Bar -->
            <Grid Grid.Column="1" Grid.Row="0" Margin="10,10,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Width="28"
                            Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{Binding EditButtonTooltip}"
                            Click="EditModeButton_Click"
                            Style="{StaticResource SidebarButtonStyle}">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{local:IconGeometry pen}"
                                  Fill="{Binding IsEditMode, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FFF59E0B|#FFFFFFFF'}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="{Binding EditModeHintText}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="2"
                            Width="28"
                            Height="28"
                            Margin="0,0,6,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{Binding PinButtonTooltip}"
                            Click="PinAutoHideButton_Click"
                            Style="{StaticResource SidebarButtonStyle}">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{local:IconGeometry pin}"
                                  Fill="{Binding PinButtonBrush}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#FF252525" CornerRadius="6" Padding="8,4" Width="130" Margin="0,0,5,0">
                            <Grid>
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="{local:IconGeometry search}" 
                                          Fill="#FF888888" Opacity="0.8"/>
                                </Viewbox>
                                <TextBox x:Name="HubSearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="White"
                                         FontSize="11"
                                         Margin="18,0,0,0"
                                         VerticalAlignment="Center"
                                         CaretBrush="#FF3B82F6"
                                         TextChanged="HubSearchBox_TextChanged"/>
                                <TextBlock Text="搜索..." 
                                           IsHitTestVisible="False"
                                           Foreground="#FF555555" 
                                           FontSize="11" 
                                           Margin="20,0,0,0" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=HubSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Grid.Row="1" Margin="10,0,10,10" MouseWheel="GlobalPanel_MouseWheel">
                <ItemsControl ItemsSource="{Binding GlobalSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SlotButtonStyle}"
                                            Margin="2"
                                            Click="SlotButton_Click"
                                            PreviewMouseLeftButtonDown="SlotButton_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="SlotButton_PreviewMouseMove"
                                            MouseEnter="SlotButton_MouseEnter"
                                            MouseLeave="SlotButton_MouseLeave"
                                            MouseMove="SlotButton_MouseMove"
                                            DragOver="SlotButton_DragOver"
                                            DragLeave="SlotButton_DragLeave"
                                            Drop="SlotButton_Drop"
                                            AllowDrop="True"
                                            Tag="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding FavoriteLabel}" Click="ToggleFavorite_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry star}" Fill="#FBBF24" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="复制扩展" Click="CopySlotExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry copy}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="剪切扩展" Click="CutSlotExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry cut}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="粘贴扩展" Click="PasteSlotExtension_Click" CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry paste}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="编辑扩展" Click="EditExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry pen}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="发布到商店" Click="PublishExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanPublish, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry publish}" Fill="#F59E0B" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="打开扩展目录" Click="OpenExtensionDirectory_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanOpenDirectory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry open-folder}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Visibility="{Binding CanRemoveFromFixedSlots, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <MenuItem Header="移除扩展" Click="RemoveExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanRemoveFromFixedSlots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry delete}" Fill="#EF4444" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Margin="0,6" HorizontalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="10" 
                                                    ClipToBounds="True"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding Command.AccentBrush, FallbackValue='#FF1E1E1E'}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Background" Value="#FF3B82F6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsReleaseTarget}" Value="True">
                                                                <Setter Property="Background" Value="#FF2563EB"/>
                                                                <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <!-- Empty: + icon via Viewbox -->
                                                    <Viewbox Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Path Data="{local:IconGeometry plus}" Fill="#22FFFFFF" Stretch="Uniform"/>
                                                    </Viewbox>
                                                    
                                                    <!-- Occupied -->
                                                    <Grid Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" Margin="2"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Viewbox Width="22" Height="22"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Border Width="9" Height="9" CornerRadius="4.5" Background="#FFFF5A7A"
                                                                BorderBrush="#CCFFFFFF" BorderThickness="1"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                                                Visibility="{Binding HasNewBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <!-- Favorite indicator -->
                                                        <Border Width="10" Height="10" CornerRadius="5" Background="#FFFBBF24"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0"
                                                                Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Border MinWidth="16" Height="16" Padding="4,0"
                                                                CornerRadius="8"
                                                                Background="#FF1D4ED8"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,2,2"
                                                                Visibility="{Binding HasFolderBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding FolderBadgeText}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title, FallbackValue='添加'}" 
                                                       Foreground="{Binding IsEmpty, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF444444|White'}" 
                                                       FontSize="10" TextAlignment="Center" Width="56" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Rectangle Grid.ColumnSpan="2" Grid.Row="2" Height="1" Fill="#18FFFFFF" Margin="8,4"/>

            <Grid Grid.Column="1" Grid.Row="3" Margin="10,10,10,10" MouseWheel="ContextPanel_MouseWheel">
                <StackPanel>
                    <TextBlock Text="{Binding ContextSectionTitle}"
                               Foreground="#FFAAAAAA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               ToolTip="{Binding ContextHintText}"/>
                    <ItemsControl ItemsSource="{Binding ContextSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SlotButtonStyle}"
                                            Margin="2"
                                            Click="SlotButton_Click"
                                            PreviewMouseLeftButtonDown="SlotButton_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="SlotButton_PreviewMouseMove"
                                            MouseEnter="SlotButton_MouseEnter"
                                            MouseLeave="SlotButton_MouseLeave"
                                            MouseMove="SlotButton_MouseMove"
                                            DragOver="SlotButton_DragOver"
                                            DragLeave="SlotButton_DragLeave"
                                            Drop="SlotButton_Drop"
                                            AllowDrop="True"
                                            Tag="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding FavoriteLabel}" Click="ToggleFavorite_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry star}" Fill="#FBBF24" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="复制扩展" Click="CopySlotExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry copy}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="剪切扩展" Click="CutSlotExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry cut}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="粘贴扩展" Click="PasteSlotExtension_Click" CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry paste}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="编辑扩展" Click="EditExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry pen}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="发布到商店" Click="PublishExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanPublish, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry publish}" Fill="#F59E0B" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="打开扩展目录" Click="OpenExtensionDirectory_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanOpenDirectory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry open-folder}" Fill="#A0FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Visibility="{Binding CanRemoveFromFixedSlots, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <MenuItem Header="移除扩展" Click="RemoveExtension_Click" CommandParameter="{Binding}"
                                                          Visibility="{Binding CanRemoveFromFixedSlots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{local:IconGeometry delete}" Fill="#EF4444" Stretch="Uniform" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Margin="0,6" HorizontalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="10"
                                                    ClipToBounds="True"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding Command.AccentBrush, FallbackValue='#FF1E1E1E'}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Background" Value="#FF3B82F6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsReleaseTarget}" Value="True">
                                                                <Setter Property="Background" Value="#FF2563EB"/>
                                                                <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Viewbox Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Path Data="{local:IconGeometry plus}" Fill="#14FFFFFF" Stretch="Uniform"/>
                                                    </Viewbox>

                                                    <Grid Visibility="{Binding IsOccupied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" Margin="2"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Viewbox Width="22" Height="22"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Border Width="9" Height="9" CornerRadius="4.5" Background="#FFFF5A7A"
                                                                BorderBrush="#CCFFFFFF" BorderThickness="1"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                                                Visibility="{Binding HasNewBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Border Width="10" Height="10" CornerRadius="5" Background="#FFFBBF24"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0"
                                                                Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Border MinWidth="16" Height="16" Padding="4,0"
                                                                CornerRadius="8"
                                                                Background="#FF1D4ED8"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,2,2"
                                                                Visibility="{Binding HasFolderBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding FolderBadgeText}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title, FallbackValue='推荐位'}"
                                                       Foreground="{Binding IsEmpty, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FF444444|White'}"
                                                       FontSize="10" TextAlignment="Center" Width="56" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1"
                    Grid.RowSpan="4"
                    Margin="10"
                    Background="#F21A1A1A"
                    CornerRadius="18"
                    BorderBrush="#FF2A2A2A"
                    BorderThickness="1"
                    Visibility="{Binding IsFolderExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Width="70"
                                Height="30"
                                Click="FolderBackButton_Click"
                                Style="{StaticResource SecondaryBtn}"
                                Content="返回" />
                        <TextBlock Text="{Binding ActiveFolderTitle}"
                                   Margin="12,0,0,0"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveFolderSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SlotButtonStyle}" Margin="2" Click="SlotButton_Click" Tag="{Binding}">
                                    <StackPanel Margin="0,6" HorizontalAlignment="Center">
                                        <Border Width="44" Height="44" CornerRadius="10" Background="{Binding Command.AccentBrush, FallbackValue='#FF1E1E1E'}" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,5">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" Margin="2"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasImageIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Viewbox Width="22" Height="22"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding HasVectorIcon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Data="{Binding VectorIcon}" Fill="White" Stretch="Uniform"/>
                                                </Viewbox>
                                                <TextBlock Text="{Binding DisplayGlyph}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding UseGlyphIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="#FFFF5A7A"
                                                        BorderBrush="#CCFFFFFF" BorderThickness="1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                                        Visibility="{Binding HasNewBadge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="10" TextAlignment="Center" Width="56" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
