<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>Yanzi.ExtensionHost</AssemblyName>
    <RootNamespace>Yanzi.ExtensionHost</RootNamespace>
    <Product>Yanzi</Product>
    <Company>Yanzi</Company>
    <Authors>Yanzi</Authors>
    <Description>Yanzi isolated extension host process for Windows extensions.</Description>
  </PropertyGroup>

</Project>
